  <!-- ==== CO GIAN GIM THEO MUC ZOOM =============================
       Gim de zoom="false" (khong meo theo anh), nhung neu de scale
       CO DINH thi luc thu nho anh gim trong to lu, luc phong to lai
       trong li ti. Nen tinh lai scale moi lan doi tam nhin:

         ti_sc = base * (fovmax / fov)      chan tren = tmax

       fov = fovmax (anh vua man)  -> gim NHO NHAT  = base
       zoom vao                    -> gim to dan, cham tran tmax roi dung

       🔴🔴🔴 20/08 (dot 8) - CACH TINH CO GIM DOI HAN. ĐỌC KỸ TRƯỚC KHI SỬA.
       Anh Tony: "may tinh icon qua nho, dien thoai icon qua to, NO BI NGUOC".
       Do lai bang so, dung y: co gim tinh bang PX TUYET DOI thi ti le so
       voi be ngang khung chay nguoc nhau:
         iPhone 6.5%  ·  iPad doc 3.1%  ·  iPad ngang 2.5%  ·  PC 1.0%
       Man cang to, gim trong cang be. Cang chinh cang hong 1 trong 2 dau.

       ✅ CACH DUNG: dat co gim theo DON VI BAN DO, khong theo px.
          ti_k (= tb cu) nay do JS TINH VA SET, theo be ngang khung:
              ti_k = K_GIM * be_ngang_khung_px / 281        (K_GIM = 0.02075)
          Vi ti_sc = ti_k / fov  va  so px tren man = 281 * ti_sc,
          suy ra chieu cao gim = K_GIM * (be_ngang_khung / fov) = K_GIM * S,
          tuc gim LUON phu dung 0.02075 don vi ban do tren MOI man.
          => Bo cuc gim giong het nhau, SO CAP DE NHAU BANG NHAU (4 cap).
          Ket qua: PC 38x48px (to len) · iPad ngang 20x25px (giu nguyen,
          Anh da duyet) · iPhone 21x27px (nho di). Dung 3 yeu cau cua Anh.

       ⚠️ ti_k / ti_tmax do `capNhatCoGim()` trong index.html set vao.
          2 dong `ifnot(... GT 0, ...)` ben duoi la DUONG LUI phong khi JS
          chua kip chay - de gim khong bao gio to bang anh goc.
       ⚠️ Nhanh `device.mobile` DA BO HAN: cong thuc moi tu thich ung theo
          be ngang khung nen khong con can tach mobile/desktop nua.

       🔴🔴 Lich su 2 lan sua truoc trong ngay, ghi de khong lap lai:
       Lan 1 Em dat tb = tmax = 0.17 cho mobile (gim CO DINH 37x48px moi
       muc zoom). SAI: dat tb = tmax la PHA MAT co che "gim nho khi zoom
       ra, to khi zoom vao" - dung cai co che sinh ra de chong chen chuc.
       Anh Tony chup iPad ngang: gim van "to qua, de len nhau".

       ⚠️ SU THAT DO DUOC, DUNG CO GANG CHUA BANG CACH DOI CO GIM:
       O muc TOAN CANH (fov ~1) tren iPad ngang, khung ban do 900px thi
       cap gim gan nhau nhat chi cach 12 px (ti_pq16 vs ti_ga11b - 2 chot
       An ninh 2 phan khu, Anh cham sat nhau o cho giao). Cum Sales Gallery
       (pq1..pq4 + pq16b) la 5 gim nam gon trong o 32x33 px.
       => KHONG CO CO GIM NAO vua bam duoc vua het de o muc toan canh.
          Cach duy nhat la de gim NHO khi zoom ra, khach zoom vao thi
          khoang cach gian ra va gim to dan len - dung cong thuc tb/fov.

       🔴 THIET BI TU VAN CHINH LA iPad GEN 9 (2021) - Anh Tony chot 20/08.
       Man 10.2 inch, 2160 x 1620 px @2x  =>  CSS 1080 x 810 pt.
       Ngang: khung ban do 800 x 634 (tru cot 280 + Safari ~90 + nav 86).
       Doc  : khung ban do 810 x 894.
       MOI LAN CHINH CO GIM PHAI TINH THEO 2 CON SO NAY TRUOC, dung lay
       iPad Pro 1180 hay may tinh lam chuan.

       Lan 2 (dot 6) dat 0.075/0.13; Anh van thay to -> ha tiep 0.060/0.115.
       Do o muc da zoom phu kin khung:
         iPad gen9 NGANG  gim 20 x 25 px   4 cap de   2.5% be ngang
         iPad gen9 DOC    gim 25 x 32 px   1 cap de   3.1%
         iPhone 14        gim 25 x 32 px   6 cap de   6.5%
         PC cua Anh       gim 23 x 30 px   0 cap de   1.0%

       So chot (do bang script dem so cap de nhau tren 6 co man):
                          CU 0.17/0.17   MOI 0.105/0.24 · 0.075/0.13
         PC cua Anh       38x48px  4 cap    23x30px  0 cap
         iPad ngang       37x48px 34 cap    17x21px  4 cap
         iPad doc (zoom)  37x48px  4 cap    29x37px  1 cap
         iPhone (zoom)    37x48px 14 cap    29x37px  6 cap
       Zoom sau them 1 nac tren iPhone: 0 cap de, gim van 29x37px
       (da cham tran nen khong to them, chi khoang cach gian ra).
       ========================================================== -->
  <action name="ti_rescale">
    set(tf, get(view.fov));
    ifnot(tf GT 0, set(tf, 1.0); );
    ifnot(ti_k GT 0,    set(ti_k,    0.105); );
    ifnot(ti_tmax GT 0, set(ti_tmax, 0.24);  );
    set(ti_sc, calc(ti_k * 1.0 / tf));
    if(ti_sc GT ti_tmax, set(ti_sc, get(ti_tmax)); );
    if(ti_sc LT 0.02, set(ti_sc, 0.02); );
    set(ti_sc_over, calc(ti_sc * 1.18));
    for(set(i,0), i LT hotspot.count, inc(i),
      if(hotspot[get(i)].tid != null,
        set(hotspot[get(i)].scale, get(ti_sc));
      );
    );
  </action>

  <events name="ti_zoom_events" keep="true"
          onviewchange="ti_rescale();" onnewpano="ti_rescale();" onxmlcomplete="ti_rescale();" />

  <!-- ==== CHE DO CHAM VI TRI ==================================
       Bat bang nut CHAM VI TRI o goc phai duoi (hoac phim V).
       Khi bat: keo duoc gim, va bam CHAM DIEM roi click len anh
       de dat 1 tien ich moi.
       ======================================================== -->
  <action name="ti_pin_down">
    if(ti_edit_on == true, draghotspot(); );
  </action>
  <action name="ti_pin_up">
    if(ti_edit_on == true, js( tiSaveDraft() ); );
  </action>

  <!-- 20/08/2026 - dong tren doi tu "if(hotspot[i].tid," sang
       "if(hotspot[i].tid != null,". Tu 20/08 tid la CHUOI CO CHU
       (pq1..pq16 / ga1..ga11) chu khong con la so 1..24. krpano co the
       ep chuoi co chu ve so -> NaN -> coi la sai -> vong lap bo qua het,
       gim se KHONG co gian theo muc zoom nua ma khong bao mot dong loi.
       Cach kiem "!= null" la cach ma ti_gather va ti_wipe van dung.

       🔴🔴 20/08/2026 - BAY: calc() KHONG NOI DUOC CHUOI CO CHU.
       Dong cu la  set(url, calc('pins27/pin-' + %3 + '.png'))  va no chay
       tot suot thoi tid con la SO (1..24). Tu khi tid thanh pq1 / ga2 thi
       krpano coi pq1 la TEN BIEN chu khong phai chuoi -> bien do khong ton
       tai -> url ra dung chu  "pins27/pin-undefined.png".
       Gim hien ra o dung toa do nhung LA O TRONG, khong mot dong loi nao.
       (Da do that tren may Anh Tony: 9/9 gim deu ra pin-undefined.png.)
       ✅ Cach dung: set(tid) TRUOC, roi txtadd(...) voi get(tid).
          txtadd noi chuoi that; get() tra ve GIA TRI da luu chu khong dien
          giai lai thanh ten bien.
       ⚠️ Khoi hotspot TINH dan tay ben duoi KHONG dinh bay nay vi url viet
          san trong the. Bay chi dinh gim tao luc chay bang ti_add.

       tao 1 gim:  ti_add( ath , atv , id , ten_hotspot )
       Gan .style luc chay KHONG an tren krpano 1.19, phai set thang
       tung thuoc tinh, neu khong gim to bang anh goc vi scale = 1.0.
       KHONG dat comment ben trong than action. -->
  <action name="ti_add">
    addhotspot(%4);
    set(hotspot[%4].tid, %3);
    txtadd(hotspot[%4].url, 'pins27/pin-', get(hotspot[%4].tid), '.png');
    set(hotspot[%4].ath, %1);
    set(hotspot[%4].atv, %2);
    set(hotspot[%4].zorder, 30);
    set(hotspot[%4].edge, bottom);
    set(hotspot[%4].distorted, false);
    set(hotspot[%4].zoom, false);
    set(hotspot[%4].scale, get(ti_sc));
    set(hotspot[%4].handcursor, true);
    set(hotspot[%4].onover, ti_over_fx(););
    set(hotspot[%4].onout, ti_out_fx(););
    set(hotspot[%4].onclick, ti_click_fx(););
    set(hotspot[%4].ondown, ti_pin_down(););
    set(hotspot[%4].onup, ti_pin_up(););
  </action>

  <action name="ti_over_fx">
    tween(scale, get(ti_sc_over), 0.1);
    js( tiOver(get(tid)) );
  </action>
  <action name="ti_out_fx">
    tween(scale, get(ti_sc), 0.1);
    js( tiOut() );
  </action>
  <action name="ti_click_fx">
    js( tiClick(get(tid)) );
  </action>

  <action name="ti_remove">
    removehotspot(%1);
    js( tiSaveDraft() );
  </action>

  <!-- click len anh khi dang cho dat diem -->
  <action name="ti_click_add">
    if(ti_edit_on == true,
      if(ti_add_mode == true,
        screentosphere(mouse.x, mouse.y, tk_ath, tk_atv);
        set(ti_add_mode, false);
        js( tiPickPlace(get(tk_ath), get(tk_atv)) );
      );
    );
  </action>

  <!-- gom toa do tat ca gim vao bien tiexp.
       Tach lam 3 action de KHONG phai truyen tham so co dau phay
       vao trong js(...) - do la cach krpano hay hieu nham. -->
  <action name="ti_collect_save">
    ti_gather();
    js( tiCollectedSave(get(tiexp)) );
  </action>

  <action name="ti_collect_export">
    ti_gather();
    js( tiCollectedExport(get(tiexp)) );
  </action>

  <action name="ti_gather">
    set(tiexp, '');
    for(set(i, 0), i LT hotspot.count, inc(i),
      if(hotspot[get(i)].tid != null,
        txtadd(tiexp, get(tiexp), get(hotspot[get(i)].tid));
        txtadd(tiexp, get(tiexp), '|');
        txtadd(tiexp, get(tiexp), get(hotspot[get(i)].ath));
        txtadd(tiexp, get(tiexp), '|');
        txtadd(tiexp, get(tiexp), get(hotspot[get(i)].atv));
        txtadd(tiexp, get(tiexp), '|');
        txtadd(tiexp, get(tiexp), get(hotspot[get(i)].name));
        txtadd(tiexp, get(tiexp), '###');
      );
    );
  </action>

  <!-- xoa sach gim, KHONG ghi de ban nhap (dung khi nap lai tu nhap) -->
  <action name="ti_wipe">
    for(set(i, hotspot.count), i GT 0, dec(i),
      set(j, calc(i - 1));
      if(hotspot[get(j)].tid != null, removehotspot(get(hotspot[get(j)].name)); );
    );
  </action>

  <!-- xoa sach VA ghi lai ban nhap rong -->
  <action name="ti_clear_all">
    ti_wipe();
    js( tiSaveDraft() );
  </action>

  <events name="ti_events" keep="true" onclick="ti_click_add();" />

