	<!-- startup action - load the first scene -->
	<!-- 11/08: scene mo dau = MA LO TREN FLYCAM (Anh Tony chot). Doi lai thi sua 1 dong duoi. -->
	<action name="startup" autorun="onstart">
		if(startscene === null OR !scene[get(startscene)], set(startscene,'scene_matbang_flycam'); );
		loadscene(get(startscene), null, MERGE);
		if(startactions !== null, startactions() );
	</action>


	
